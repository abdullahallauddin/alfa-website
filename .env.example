# Copy this file to `.env.local` and fill in real values.
# Vite only exposes variables prefixed with `VITE_` to the client bundle.

# --- ALFA contact form (Bigin / Zoho Web-to-Contact) ----------------------
# Required. The form action URL Bigin generates for your "Web to Contact"
# embed. To find it:
#   1. Open Bigin → Settings → Forms → "Contact Us" → Embed in website.
#   2. Copy the value of the <form action="…"> attribute.
#   3. Paste it below.
VITE_BIGIN_FORM_ACTION=

# Optional. Page Bigin should redirect to after a successful submission.
# Most installs leave this blank since the SPA shows its own success state.
VITE_BIGIN_RETURN_URL=
